{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "pinDigests": true,
  "packageRules": [
    {
      "matchManagers": ["devcontainer", "dockerfile", "docker-compose", "custom.regex"],
      "groupName": "devcontainer and docker updates"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "lockFileMaintenance"],
      "groupName": "npm dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm major dependencies"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDepNames": [
        "cr.sas.com/viya-4-x64_oci_linux_2-docker/sas-analytics-pro",
        "load-envs",
        "aou-extension-builder",
        "extension-builder",
        "jupyter-extension-builder",
        "wb-secret-receiver"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^startupscript/butane/.*\\.sh$"],
      "matchStrings": [
        "(?<depName>[\\w./_-]+):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "ignorePaths": [".github/workflows/**"],
  "copier": {
    "enabled": false
  }
}
