{
  extends: [
    'config:best-practices',
  ],
  commitMessageSuffix: ' in {{packageFile}}',
  packageRules: [
    {
      matchManagers: [
        'dockerfile',
      ],
      matchDepNames: [
        'cr.sas.com/viya-4-x64_oci_linux_2-docker/sas-analytics-pro',
        'load-envs',
        'aou-extension-builder',
        'extension-builder',
        'jupyter-extension-builder',
        'wb-secret-receiver',
      ],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^startupscript/butane/.*\\.sh$/',
      ],
      matchStrings: [
        '(?<depName>[\\w./_-]+):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  ignorePaths: [
    '.github/workflows/**',
  ],
  copier: {
    enabled: false,
  },
}
